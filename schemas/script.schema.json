{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yam-my-drama/schemas/script.schema.json",
  "title": "Script YAML Schema",
  "description": "yam-my-drama 剧本 YAML 结构校验定义 v1.0.0",
  "type": "object",
  "required": ["schema_version", "meta", "characters", "acts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "meta": { "$ref": "#/$defs/meta" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/character" }
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/act" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["title", "author", "source_novel", "created_at", "language"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "author": { "type": "string", "minLength": 1 },
        "source_novel": { "$ref": "#/$defs/source_novel" },
        "genre": { "type": "string" },
        "logline": { "type": "string" },
        "created_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "language": { "type": "string", "minLength": 2 },
        "notes": { "type": "string" }
      }
    },
    "source_novel": {
      "type": "object",
      "required": ["title", "author", "chapters_covered"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "chapters_covered": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        }
      }
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "role", "first_appeared"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^char_[a-z0-9_]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["protagonist", "antagonist", "supporting", "extra"]
        },
        "first_appeared": { "$ref": "#/$defs/scene_ref" },
        "traits": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scene_ref": {
      "type": "object",
      "required": ["act", "scene"],
      "additionalProperties": false,
      "properties": {
        "act": { "type": "integer", "minimum": 1 },
        "scene": {
          "type": "string",
          "pattern": "^\\d+-\\d+$"
        }
      }
    },
    "act": {
      "type": "object",
      "required": ["act", "title", "scenes"],
      "additionalProperties": false,
      "properties": {
        "act": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scene" }
        }
      }
    },
    "scene": {
      "type": "object",
      "required": ["scene_id", "scene_number", "heading", "action_blocks", "dialogues"],
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^\\d+-\\d+$"
        },
        "scene_number": { "type": "integer", "minimum": 1 },
        "heading": { "$ref": "#/$defs/heading" },
        "source_mapping": { "$ref": "#/$defs/source_mapping" },
        "action_blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dialogues": {
          "type": "array",
          "items": { "$ref": "#/$defs/dialogue" }
        },
        "transition": { "type": "string" },
        "duration_estimate": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "heading": {
      "type": "object",
      "required": ["int_ext", "location", "time"],
      "additionalProperties": false,
      "properties": {
        "int_ext": {
          "type": "string",
          "enum": ["INT", "EXT", "INT/EXT"]
        },
        "location": { "type": "string", "minLength": 1 },
        "time": {
          "type": "string",
          "enum": ["DAY", "NIGHT", "DAWN", "DUSK", "CONTINUOUS"]
        },
        "season": {
          "type": "string",
          "enum": ["SPRING", "SUMMER", "AUTUMN", "WINTER", ""]
        }
      }
    },
    "source_mapping": {
      "type": "object",
      "required": ["chapter"],
      "additionalProperties": false,
      "properties": {
        "chapter": { "type": "integer", "minimum": 1 },
        "paragraph_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "excerpt": { "type": "string" }
      }
    },
    "dialogue": {
      "type": "object",
      "required": ["character_id", "line"],
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "type": "string",
          "pattern": "^char_[a-z0-9_]+$"
        },
        "line": { "type": "string" },
        "parenthetical": { "type": "string" },
        "emotion": { "type": "string" },
        "voice_over": { "type": "boolean" }
      }
    }
  }
}
